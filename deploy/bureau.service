[Unit]
Description=Freeboard bureau (accountless ingest, pooled priors, chain anchoring)
Documentation=https://github.com/kaustubhspatil/agent-credibility
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freeboard
Group=freeboard
WorkingDirectory=/opt/freeboard
Environment=PYTHONPATH=/opt/freeboard/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m bureau.app --db /var/lib/freeboard/bureau.db --host 127.0.0.1 --port 8080

# spot host can be preempted anytime, always restart
Restart=always
RestartSec=3

# sandbox it, it parses untrusted json
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/freeboard
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
