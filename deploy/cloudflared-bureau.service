[Unit]
Description=Cloudflare tunnel for the Freeboard bureau
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps
After=network-online.target bureau.service
Wants=network-online.target

[Service]
Type=simple
User=sentinel
# quick tunnel: no CF account or open ports needed
# hostname changes on restart, use a named tunnel for anything real
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
