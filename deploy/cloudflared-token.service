[Unit]
Description=Cloudflare named tunnel for the Freeboard bureau (dashboard-managed)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target bureau.service
Wants=network-online.target

[Service]
Type=simple
User=sentinel

# token from env, not argv (visible in ps)
EnvironmentFile=/etc/cloudflared/token.env
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --loglevel info tunnel run

Restart=always
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
